# launcher/.env.example – copy thành launcher/.env (không commit). tools/deploy.sh chép file này lên board.
# Chấp nhận cả kiểu  KEY=value  và  key: "value"  (teleBotToken / teleChatId cũng được)
TG_BOT_TOKEN=<token từ BotFather>
TG_CHAT_ID=<chat id nhận cảnh báo>
THRESHOLD_KG=0.15
QUEUE_SIZE=50
SERIAL_PORT=/dev/ttyACM0
CAMERA_DEVICE=auto
DATA_DIR=~/vehicle-scale-ptit/data
STATION_NAME=Trạm cân PTIT
